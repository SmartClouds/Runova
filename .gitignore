node_modules/
dist/
dist-electron/
out/
release/
build/
!apps/desktop/build/
# CD puts the server core release manifest here before packaging; never commit one.
apps/desktop/build/server-core-manifest.json
apps/desktop/build/remote-agent/
*.log
.DS_Store
.env
.env.local
# Production secrets for the website (apps/website/docker-compose.production.yaml)
.env.production
*.tsbuildinfo
.vite/
coverage/
# Vitest blob reports from sharded runs (CI merges them)
.vitest/

# Desktop e2e build and Playwright output
apps/desktop/out-e2e/
apps/desktop/src/renderer/out-e2e/
apps/desktop/test-results/
apps/desktop/playwright-report/

# Server core (.NET) build output
apps/server-core/**/bin/
apps/server-core/**/obj/
apps/server-core/artifacts/

# Website API (.NET) build output and Verify snapshots that did not match
apps/website/api/**/bin/
apps/website/api/**/obj/
# Runova Anywhere agent (.NET) build output
apps/remote-agent/**/bin/
apps/remote-agent/**/obj/
apps/remote-agent/**/TestResults/
apps/website/api/**/*.received.*
# The local Monitoring Gateway certificate (apps/website/compose.yaml, monitoring profile).
apps/website/monitoring-tls/
# A monitoring node's settings, which hold its one-time enrollment token.
apps/website/monitoring-node/.env

# WordPress connector plugin: Composer dev tools, PHPUnit cache, and the file activation writes
apps/wordpress-connector/vendor/
apps/wordpress-connector/.phpunit.cache/
apps/wordpress-connector/rescue-config.php
