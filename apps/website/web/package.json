{
  "name": "@runova/website-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist/client && bun scripts/seoCheck.ts",
    "preview": "bun scripts/preview.ts",
    "start": "bun scripts/server.ts",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:stack": "playwright test -c playwright.stack.config.ts",
    "lighthouse": "bun scripts/lighthouse.ts",
    "lighthouse:stack": "bun scripts/lighthouseStack.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.2",
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@sentry/astro": "11.10.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "fontkitten": "1.0.3",
    "lucide-react": "1.65.0",
    "marked": "18.1.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "schema-dts": "2.1.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "fast-xml-parser": "5.11.2",
    "jsdom": "30.1.3",
    "pagefind": "1.5.2",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
