---
import AppScreenshot from '../components/AppScreenshot.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Icon from '../components/effects/Icon.astro';
import DownloadSplit from '../components/home/DownloadSplit.astro';
import HeroDemo from '../components/home/HeroDemo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ADE_POINTS, AGENT_CLIS, HIGHLIGHTS } from '../lib/home';
import { softwareApplication } from '../lib/seo';

const site = Astro.site ?? new URL('https://runovahq.com');
const description =
  'Runova runs your AI coding agents side by side, with git, review, tests and deploys in the same window. Free and open source for Windows, macOS and Linux.';

const app = softwareApplication(site);

// The systems the desktop app ships for, in the order the download menu lists them.
const PLATFORMS: Array<{ label: string; mark: 'apple' | 'windows' | 'linux' }> = [
  { label: 'macOS', mark: 'apple' },
  { label: 'Windows', mark: 'windows' },
  { label: 'Linux', mark: 'linux' },
];

const sectionTitle = 'font-bold text-[clamp(1.85rem,4.2vw,3rem)] tracking-[-0.03em]';
---

<BaseLayout description={description} jsonLd={[app]}>
  <section
    id="hero"
    aria-labelledby="hero-title"
    class="hero relative -mx-4 px-4 pt-12 pb-16 md:-mx-6 md:px-6 md:pt-16 md:pb-24"
  >
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="hero-beam" aria-hidden="true" data-beam-stage><canvas></canvas></div>
    <div class="mx-auto flex max-w-[56rem] flex-col items-center text-center">
      <h1
        id="hero-title"
        class="hero-rise text-balance font-extrabold text-[clamp(2.75rem,8.5vw,6.25rem)] leading-[0.98] tracking-[-0.035em]"
        style="--order: 0"
      >
        Run the work, <span class="hero-rise hero-tail" style="--order: 1">not just watch it.</span>
      </h1>
      <p
        class="hero-rise mt-6 max-w-[46rem] text-balance text-lg text-muted-foreground md:text-xl"
        style="--order: 2"
      >
        Put Claude Code, Codex, Cursor, Gemini or a plain shell in every pane of one window. Git,
        diffs, tests and pipelines sit right next to the agents, so a change goes from prompt to
        commit without leaving the app.
      </p>
      <div
        class="hero-rise platforms mt-8 inline-flex items-center gap-2.5 rounded-full border bg-card/60 py-1 pr-4 pl-1 text-muted-foreground text-xs backdrop-blur max-[359px]:gap-1.5 max-[359px]:pr-3 max-[359px]:text-[0.7rem] sm:gap-3 sm:text-sm"
        style="--order: 3"
      >
        <span
          class="rounded-full bg-foreground px-2.5 py-1 font-semibold text-[0.65rem] text-background uppercase tracking-[0.08em]"
        >
          Free
        </span>
        <span class="max-sm:hidden">Available on</span>
        <ul class="flex items-center">
          {
            PLATFORMS.map((platform) => (
              <li class="flex items-center gap-1.5 font-semibold text-foreground">
                <Icon name={platform.mark} size={14} />
                {platform.label}
              </li>
            ))
          }
        </ul>
      </div>
      <p class="hero-rise mt-4 text-muted-foreground text-sm" style="--order: 4">
        Open source under the MIT license.
      </p>
    </div>
    <HeroDemo class="hero-rise mt-12 md:mt-14" />
  </section>

  <section id="ade" aria-labelledby="ade-title" class="below-fold py-20 md:py-28">
    <div data-reveal class="max-w-[44rem]">
      <p class="font-mono text-primary text-xs uppercase tracking-[0.14em]">Why an ADE</p>
      <h2 id="ade-title" class:list={[sectionTitle, 'mt-3']}>
        Built for agents doing the typing
      </h2>
      <p class="mt-5 text-lg text-muted-foreground">
        An IDE is built around a person typing code. An ADE is built around agents writing it and a
        person steering. That changes what the app has to do.
      </p>
    </div>
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        ADE_POINTS.map((point, index) => (
          <li
            data-reveal
            data-spotlight
            style={`--reveal-order: ${index}`}
            class:list={[
              'ade-card rounded-box border bg-card p-6 transition-colors duration-[120ms] hover:border-primary/40 md:p-7',
              index === 0 && 'sm:col-span-2',
            ]}
          >
            <span class="inline-flex size-10 items-center justify-center rounded-inner border bg-background text-primary">
              <Icon name={point.icon} size={20} />
            </span>
            <h3
              class:list={[
                'mt-5 font-semibold',
                index === 0 ? 'text-[clamp(1.35rem,2.4vw,1.75rem)]' : 'text-lg',
              ]}
            >
              {point.title}
            </h3>
            <p class:list={['mt-2 text-muted-foreground', index === 0 && 'max-w-[38rem]']}>
              {point.body}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="features" aria-labelledby="features-title" class="below-fold border-t py-20 md:py-28">
    <div data-reveal class="max-w-[44rem]">
      <p class="font-mono text-primary text-xs uppercase tracking-[0.14em]">Inside the app</p>
      <h2 id="features-title" class:list={[sectionTitle, 'mt-3']}>
        Everything the loop needs, next to the agents
      </h2>
    </div>
    <div class="mt-16 flex flex-col gap-24 md:gap-32">
      {
        HIGHLIGHTS.map((highlight, index) => (
          <article
            aria-labelledby={`highlight-${highlight.slug}`}
            class="grid items-center gap-8 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-14"
          >
            <div data-reveal class:list={[index % 2 === 1 && 'md:order-last']}>
              <p class="font-mono text-primary text-xs uppercase tracking-[0.14em]">
                {highlight.eyebrow}
              </p>
              <h3
                id={`highlight-${highlight.slug}`}
                class="mt-3 font-bold text-[clamp(1.45rem,3vw,2.1rem)] tracking-[-0.025em]"
              >
                {highlight.title}
              </h3>
              <p class="mt-4 text-muted-foreground">{highlight.body}</p>
              <a
                href={`/features/${highlight.slug}`}
                class="link group mt-5 inline-flex items-center gap-1.5"
              >
                More about {highlight.eyebrow.toLowerCase()}
                <Icon name="arrow-right" size={16} class="nudge" />
              </a>
            </div>
            <div data-reveal class="shot-tilt">
              <AppScreenshot name={highlight.shot} class="shadow-[0_30px_80px_-40px_hsl(var(--glow)/0.35)]" />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="agents" aria-labelledby="agents-title" class="below-fold border-t py-20 md:py-24">
    <div data-reveal class="mx-auto max-w-[44rem] text-center">
      <h2 id="agents-title" class="font-bold text-[clamp(1.6rem,3.2vw,2.4rem)] tracking-[-0.03em]">
        Works with the agents you already use
      </h2>
      <p class="mt-4 text-muted-foreground">
        The AI CLI Manager finds these on your machine and installs or updates the missing ones.
        Anything else runs in a shell pane.
      </p>
    </div>
    <div class="marquee mt-10" data-reveal>
      <div class="marquee-track">
        {
          [false, true].map((copy) => (
            <ul class="marquee-list" aria-hidden={copy ? 'true' : undefined} data-copy={copy ? '' : undefined}>
              {AGENT_CLIS.map((cli) => (
                <li class="rounded-full border bg-card px-4 py-2 font-mono text-sm whitespace-nowrap">{cli}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <section id="download" aria-labelledby="download-title" class="py-16 md:py-24">
    <div
      data-reveal
      class="cta relative rounded-box border bg-card px-6 py-14 text-center md:px-12 md:py-20"
    >
      <h2 id="download-title" class="font-extrabold text-[clamp(2rem,5vw,3.5rem)] tracking-[-0.035em]">
        Get Runova
      </h2>
      <p class="mx-auto mt-4 max-w-[60ch] text-lg text-muted-foreground">
        Installers for Windows, macOS and Linux, with updates from inside the app.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <DownloadSplit id="cta-download" />
      </div>
      <p class="mt-6 text-muted-foreground text-sm">On Windows:</p>
      <CopyCommand class="mt-2" command="winget install SmartClouds.Runova" label="winget command" />
    </div>
  </section>
</BaseLayout>

<script>
  import { setUpBeamWhenIdle } from '../components/effects/beam';
  import { setUpReveal } from '../components/effects/reveal';
  import { setUpSpotlight } from '../components/effects/spotlight';
  import { setUpDownloadSplits } from '../components/home/downloadSplit';

  setUpReveal();
  setUpSpotlight();
  setUpDownloadSplits();

  // The beam falls from the header's Download button onto the workspace window.
  const host = document.querySelector<HTMLElement>('#hero');
  const stage = host?.querySelector<HTMLElement>('[data-beam-stage]');
  const surface = host?.querySelector<HTMLElement>('.demo-window');
  const header = document.querySelector<HTMLElement>('body > header');
  const source = header?.querySelector<HTMLElement>('[data-beam-source]');
  if (host && stage && source && surface) setUpBeamWhenIdle({ host, stage, source, surface });

  // At the top of the page the header is see-through, so the light shows behind it.
  if (header) {
    const clear = () => header.toggleAttribute('data-clear', scrollY < 8);
    clear();
    addEventListener('scroll', clear, { passive: true });
  }
</script>

<style>
  .hero {
    isolation: isolate;
  }

  /* A soft green light that rises from behind the workspace. */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 45% at 50% 80%, hsl(var(--glow) / 0.18), transparent 70%),
      radial-gradient(ellipse 70% 50% at 50% 0%, hsl(var(--glow) / 0.07), transparent 70%);
  }

  /* The beam (src/components/effects/beam.ts). It spans the whole window, from the top edge of the
     window (where the header's Download button sits) down through the hero, and fades out at the
     bottom. */
  :global(body) {
    overflow-x: clip;
  }

  .hero-beam {
    position: absolute;
    top: -3.5rem;
    bottom: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    pointer-events: none;
    transform: translateX(-50%);
    mask-image: linear-gradient(black 75%, transparent);
  }

  .hero-beam canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The shader draws its own light, so the soft glow steps back while it runs. */
  .hero[data-beam="on"] .hero-backdrop,
  .hero[data-beam="still"] .hero-backdrop {
    display: none;
  }

  :global(header[data-clear]) {
    border-color: transparent;
    background: transparent;
    backdrop-filter: none;
    transition:
      background-color 200ms var(--ease-enter),
      border-color 200ms var(--ease-enter);
  }

  /* No WebGL2 (or a lost context): a still line of light in the same place. */
  .hero[data-beam="fallback"] .hero-beam::before {
    content: "";
    position: absolute;
    top: var(--beam-from, 0);
    left: calc(var(--beam-x, 50%) - 40px);
    width: 80px;
    height: calc(var(--beam-to, 40%) - var(--beam-from, 0px) + 12px);
    background:
      linear-gradient(90deg, transparent 49.4%, hsl(var(--glow) / 0.9) 50%, transparent 50.6%),
      radial-gradient(ellipse 50% 100% at 50% 100%, hsl(var(--glow) / 0.5), transparent 70%);
  }

  .hero-tail {
    color: hsl(var(--muted-foreground));
  }

  /* A small dot between the systems in the pill above the headline. */
  .platforms li + li::before {
    content: "";
    width: 3px;
    height: 3px;
    margin-inline: 0.5rem 0.125rem;
    border-radius: 9999px;
    background: hsl(var(--muted-foreground) / 0.6);
  }

  @media (max-width: 359px) {
    .platforms li + li::before {
      margin-inline: 0.3rem 0;
    }
  }

  /* The opening sequence: eyebrow, headline, its second half, lead, note, then the
     workspace. It starts at opacity 0.01, never 0, so the headline still counts as the largest
     paint for LCP. */
  /* Sections below the hero skip style, layout and paint until they come near the screen, which
     takes a large share off the first frame on a phone and stops the marquee while it is out of
     sight. The sizes are their measured heights, so the scrollbar barely moves when they render,
     and `auto` keeps the real height once they have. The download section is left out: its menu
     opens past the section's edge, and the paint containment this brings would clip it. */
  .below-fold {
    content-visibility: auto;
    contain-intrinsic-size: auto var(--fold-height);
  }

  #ade {
    --fold-height: 1820px;
  }

  #features {
    --fold-height: 3910px;
  }

  #agents {
    --fold-height: 390px;
  }

  @media (min-width: 768px) {
    #ade {
      --fold-height: 1240px;
    }

    #features {
      --fold-height: 2720px;
    }
  }

  @media (min-width: 1024px) {
    #ade {
      --fold-height: 960px;
    }

    #features {
      --fold-height: 3130px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.hero-rise) {
      animation: hero-rise 800ms var(--ease-enter) both;
      animation-delay: calc(var(--order, 5) * 90ms);
    }

    .hero-tail {
      display: inline-block;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0.01;
      transform: translateY(18px);
    }
  }

  :global(.nudge) {
    transition: transform 120ms var(--ease-enter);
  }

  :global(.group:hover .nudge) {
    transform: translateX(3px);
  }

  .ade-card :global(h3) {
    letter-spacing: -0.02em;
  }

  /* Screenshots lie back a little while they wait and settle flat as they come in. */
  .shot-tilt[data-reveal="waiting"] {
    transform: perspective(1400px) rotateX(9deg) translateY(2.5rem) scale(0.97);
    transform-origin: 50% 0;
  }

  .shot-tilt[data-reveal="shown"] {
    transition-duration: 800ms;
  }

  /* One marquee of the agent CLIs (design.md allows exactly one). Same idea as RareUI's marquee
     (https://rareui.in), written from scratch in CSS. It pauses under the pointer or keyboard
     focus, and with reduced motion it is a plain wrapped list. */
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .marquee-list {
    display: flex;
    gap: 0.75rem;
    padding-right: 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 40s linear infinite;
    }

    .marquee:hover .marquee-track,
    .marquee:focus-within .marquee-track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }

    .marquee-track {
      width: auto;
    }

    .marquee-list {
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
    }

    .marquee-list[data-copy] {
      display: none;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* The card does not clip its content, so the download menu can open past its edge; the light
     keeps to the rounded corners by itself. */
  .cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 55% at 50% 0%, hsl(var(--glow) / 0.18), transparent 70%),
      linear-gradient(90deg, transparent, hsl(var(--glow) / 0.7), transparent) top / 70% 1px
        no-repeat;
  }

  .cta > :global(*) {
    position: relative;
  }
</style>
