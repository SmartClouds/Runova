---
import NotFound from '../../components/NotFound.astro';
import AffectedList from '../../components/news/AffectedList.astro';
import CategoryChip from '../../components/news/CategoryChip.astro';
import NewsUnavailable from '../../components/news/NewsUnavailable.astro';
import SecurityBox from '../../components/news/SecurityBox.astro';
import SeverityBadge from '../../components/news/SeverityBadge.astro';
import Prose from '../../components/Prose.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { applyState } from '../../lib/blog/page';
import { formatLongDate, isoTime } from '../../lib/dates';
import { NEWS_SLUG, type NewsItem, newsApi } from '../../lib/news/api';
import { CACHE, CATEGORY_LABELS, newsArticle } from '../../lib/news/page';
import { fitMetaDescription } from '../../lib/seo';

// Rendered per request from the API; the proxy caches it by its Cache-Control.
export const prerender = false;

const site = Astro.site ?? new URL('https://runovahq.com');
const slug = Astro.params.slug ?? '';
// A slug the API's route would refuse is never an item, so the API is not asked.
const result = NEWS_SLUG.test(slug)
  ? await newsApi().getNewsItem(slug)
  : ({ ok: false, reason: 'not-found' } as const);
const item: NewsItem | undefined = result.ok ? result.value : undefined;
applyState(Astro.response, result.ok ? 'ok' : result.reason, CACHE.item);

const description = item
  ? fitMetaDescription(item.summary, `${CATEGORY_LABELS[item.category]} news from Runova.`)
  : '';
const edited = item && isoTime(item.updatedAt) !== isoTime(item.publishedAt);
---

{
  item ? (
    <BaseLayout title={item.title} description={description} type="article" jsonLd={[newsArticle(site, item)]}>
      <link slot="head" rel="alternate" type="application/rss+xml" title="Runova news" href="/news/rss.xml" />
      <article class="max-w-[800px] pt-12 pb-16 md:pt-20 md:pb-24">
        <header>
          <p class="text-sm">
            <a href="/news" class="text-primary underline underline-offset-4">News</a>
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <CategoryChip category={item.category} />
            <span class="sr-only">Severity:</span>
            <SeverityBadge severity={item.severity} />
          </div>
          <h1 class="mt-3 text-balance font-bold text-[clamp(2rem,5vw,3rem)] leading-[1.1]">{item.title}</h1>
          <p class="mt-5 text-lg text-muted-foreground">{item.summary}</p>
          <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-muted-foreground text-sm">
            <span>
              Published <time datetime={isoTime(item.publishedAt)}>{formatLongDate(item.publishedAt)}</time>
            </span>
            {edited && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  Updated <time datetime={isoTime(item.updatedAt)}>{formatLongDate(item.updatedAt)}</time>
                </span>
              </>
            )}
          </p>
        </header>
        {item.category === 'security' ? (
          <SecurityBox item={item} level="h2" class="mt-8" />
        ) : (
          <AffectedList technologies={item.technologies} label="Technologies" class="mt-6" />
        )}
        <Prose html={item.bodyHtml} class="mt-8" />
        {item.sourceLinks.length > 0 && (
          <section aria-labelledby="sources-heading" class="mt-10 border-t pt-6">
            <h2 id="sources-heading" class="font-semibold text-lg">Sources</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {item.sourceLinks.map((source) => (
                <li>
                  <a href={source.url} class="text-primary underline underline-offset-4" rel="noopener noreferrer">
                    {source.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>
    </BaseLayout>
  ) : !result.ok && result.reason === 'not-found' ? (
    <NotFound />
  ) : (
    <NewsUnavailable />
  )
}
