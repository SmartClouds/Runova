---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/admin/guard';

export const prerender = false;

const user = Astro.locals.adminUser;
const cards = [
  { href: '/admin/news', label: 'News', text: 'Security advisories, releases and the rest of the news feed.' },
  { href: '/admin/blog', label: 'Blog', text: 'Posts with a cover, tags and a publish time.' },
  ...(isAdmin(user)
    ? [
        {
          href: '/admin/reports',
          label: 'Reports',
          text: 'How many people use Runova, who joined lately, their sessions, teams and sync, and the content on the site.',
        },
        {
          href: '/admin/users',
          label: 'Users',
          text: 'Everyone who can sign in: staff and Runova accounts. Search, roles, two-factor and disabling.',
        },
        {
          href: '/admin/api-clients',
          label: 'API clients',
          text: 'The systems allowed to write news, with their keys, scopes and allowed addresses.',
        },
        {
          href: '/admin/settings',
          label: 'Sign-in settings',
          text: 'The captcha on sign-in and sign-up, and Continue with Google, with their keys.',
        },
        { href: '/hangfire', label: 'Jobs', text: 'The background jobs dashboard.' },
      ]
    : []),
];
---

<AdminLayout title="Overview">
  <h1 class="font-display font-extrabold text-3xl tracking-tight">Hello, {user?.displayName}</h1>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      cards.map((card) => (
        <li class="rounded-box border p-5">
          <a href={card.href} class="font-semibold text-lg transition-colors duration-[120ms] hover:text-primary">
            {card.label}
          </a>
          <p class="mt-2 text-muted-foreground text-sm">{card.text}</p>
        </li>
      ))
    }
  </ul>
</AdminLayout>
