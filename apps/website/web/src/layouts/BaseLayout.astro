---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import type { ComponentProps } from 'astro/types';
import Tracking from '../components/analytics/Tracking.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import { TRACKING_CSP } from '../lib/analytics';

type Props = ComponentProps<typeof SeoHead>;

// The public pages may load the tracking tags an Admin sets. The admin pages and the account panel
// have layouts of their own, so their CSP never allows them. Undefined when the CSP is off (astro dev).
for (const source of TRACKING_CSP.scriptSrc) Astro.csp?.insertScriptResource(source);
for (const directive of TRACKING_CSP.directives) Astro.csp?.insertDirective(directive);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <SeoHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-full bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-[1200px] flex-1 px-4 md:px-6">
      <slot />
    </main>
    <Footer />
    <Tracking />
  </body>
</html>
