---
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Screenshot from '../components/features/Screenshot.astro';
import { featureCrumbs, groupLabel } from '../lib/features';
import { helpArticleTitle } from '../lib/helpArticles';
import { breadcrumbList } from '../lib/seo';
import BaseLayout from './BaseLayout.astro';

interface Props {
  slug: string;
  data: CollectionEntry<'features'>['data'];
  /** The entry's rendered MDX body. */
  Content: AstroComponentFactory;
}

const { slug, data, Content } = Astro.props;
const site = Astro.site ?? new URL('https://runovahq.com');
const crumbs = featureCrumbs({ slug, title: data.title });
---

<BaseLayout title={data.title} description={data.description} jsonLd={[breadcrumbList(site, crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="pb-16 md:pb-24">
    <header class="max-w-[70ch] pt-6">
      <p class="font-medium text-primary text-sm">{groupLabel(data.group)}</p>
      <h1 class="mt-2 text-balance font-bold text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.1]">{data.title}</h1>
      <p class="mt-5 text-lg text-muted-foreground">{data.summary}</p>
    </header>

    <div class="feature-prose mt-10 max-w-[800px]">
      <Content components={{ Screenshot }} />
    </div>

    <section aria-labelledby="help-title" class="mt-16 max-w-[800px] border-t pt-10">
      <h2 id="help-title" class="font-semibold text-2xl">In the help center</h2>
      <ul class="mt-4 flex flex-col gap-2">
        {
          data.help.map((name) => (
            <li>
              <a href={`/help/${name}`} class="text-primary underline underline-offset-4">{helpArticleTitle(name)}</a>
            </li>
          ))
        }
      </ul>
      <p class="mt-10">
        <a href="/features" class="text-primary underline underline-offset-4">See all features</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .feature-prose {
    line-height: 1.6;
  }

  .feature-prose :global(h2) {
    margin-top: 3.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .feature-prose :global(h3) {
    margin-top: 2rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .feature-prose :global(p),
  .feature-prose :global(ul) {
    margin-top: 1rem;
    max-width: 70ch;
    color: hsl(var(--muted-foreground));
  }

  .feature-prose :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .feature-prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .feature-prose :global(strong) {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .feature-prose :global(code) {
    border-radius: calc(var(--radius) - 4px);
    background: hsl(var(--secondary));
    padding: 0.1rem 0.35rem;
    color: hsl(var(--secondary-foreground));
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .feature-prose :global(a) {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
