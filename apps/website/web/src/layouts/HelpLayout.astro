---
import { getImage } from 'astro:assets';
import AppScreenshot from '../components/AppScreenshot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { HelpArticleData } from '../lib/help/articles';
import { helpCrumbs, helpMetaDescription, helpTechArticle } from '../lib/help/page';
import { screenshot } from '../lib/screenshots';
import { breadcrumbList } from '../lib/seo';
import BaseLayout from './BaseLayout.astro';

interface ArticleLink {
  slug: string;
  title: string;
}

interface Props {
  slug: string;
  data: HelpArticleData;
  /** The article body, rendered and filtered by the help loader. */
  html: string;
  previous?: ArticleLink;
  next?: ArticleLink;
  /** The features page for the article's in-app route. */
  feature?: ArticleLink;
  /** The screenshot name for the article's route. */
  shot?: string;
}

const { slug, data, html, previous, next, feature, shot } = Astro.props;
const site = Astro.site ?? new URL('https://runovahq.com');
const crumbs = helpCrumbs({ slug, title: data.title });
const description = helpMetaDescription(data.summary);
const image = shot
  ? (await getImage({ src: screenshot(shot).image, format: 'webp', width: 1600 })).src
  : undefined;
const jsonLd = [
  helpTechArticle(site, {
    slug,
    title: data.title,
    description,
    category: data.category,
    keywords: data.keywords,
    ...(image ? { image } : {}),
  }),
  breadcrumbList(site, crumbs),
];
const link = 'text-primary underline underline-offset-4';
---

<BaseLayout title={data.title} description={description} type="article" jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="pb-16 md:pb-24 lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-12">
    <article data-pagefind-body class="min-w-0">
      <header class="max-w-[70ch] pt-6">
        <p class="font-medium text-primary text-sm" data-pagefind-meta="category">{data.category}</p>
        <h1 class="mt-2 text-balance font-bold text-[clamp(2rem,5vw,3rem)] leading-[1.1]">{data.title}</h1>
        <p class="mt-5 text-lg text-muted-foreground">{data.summary}</p>
        <div hidden data-pagefind-index-attrs="data-keywords" data-keywords={data.keywords.join(', ')}></div>
        {
          feature && (
            <p class="mt-4 text-sm" data-pagefind-ignore>
              Read about this part of Runova on the <a href={`/features/${feature.slug}`} class={link}>{feature.title}</a> page.
            </p>
          )
        }
      </header>

      {shot && <AppScreenshot name={shot} loading="eager" sizes="(min-width: 1200px) 800px, (min-width: 1024px) 66vw, 100vw" class="mt-8 max-w-[800px]" />}

      <div class="help-prose mt-8 max-w-[800px]" set:html={html} />
    </article>

    {
      data.toc.length > 0 && (
        <aside class="hidden lg:block" data-pagefind-ignore>
          <nav aria-label="On this page" class="sticky top-20 pt-6 text-sm">
            <p class="font-semibold">On this page</p>
            <ul class="mt-3 flex flex-col gap-2 border-l">
              {data.toc.map((item) => (
                <li class:list={[item.level === 3 ? 'pl-6' : 'pl-3']}>
                  <a href={`#${item.id}`} class="text-muted-foreground hover:text-foreground">{item.heading}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>

  <nav aria-label="More articles" class="mb-16 grid max-w-[800px] gap-4 border-t pt-8 sm:grid-cols-2" data-pagefind-ignore>
    {
      previous ? (
        <a href={`/help/${previous.slug}`} rel="prev" class="rounded-lg border p-4 hover:border-primary/60">
          <span class="block text-muted-foreground text-sm">Previous</span>
          <span class="font-medium">{previous.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a href={`/help/${next.slug}`} rel="next" class="rounded-lg border p-4 text-right hover:border-primary/60">
          <span class="block text-muted-foreground text-sm">Next</span>
          <span class="font-medium">{next.title}</span>
        </a>
      )
    }
  </nav>
</BaseLayout>

<style>
  .help-prose {
    line-height: 1.65;
  }

  .help-prose :global(h2) {
    margin-top: 3rem;
    scroll-margin-top: 5rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .help-prose :global(h3),
  .help-prose :global(h4) {
    margin-top: 2rem;
    scroll-margin-top: 5rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .help-prose :global(p),
  .help-prose :global(ul),
  .help-prose :global(ol),
  .help-prose :global(table),
  .help-prose :global(pre),
  .help-prose :global(blockquote) {
    margin-top: 1rem;
  }

  .help-prose :global(p),
  .help-prose :global(li) {
    max-width: 70ch;
    color: hsl(var(--muted-foreground));
  }

  .help-prose :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .help-prose :global(ol) {
    padding-left: 1.5rem;
    list-style: decimal;
  }

  .help-prose :global(li + li) {
    margin-top: 0.4rem;
  }

  .help-prose :global(strong) {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .help-prose :global(code) {
    border-radius: calc(var(--radius) - 4px);
    background: hsl(var(--secondary));
    padding: 0.1rem 0.35rem;
    color: hsl(var(--secondary-foreground));
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .help-prose :global(pre) {
    overflow-x: auto;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: 1rem;
  }

  .help-prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .help-prose :global(a) {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .help-prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.925rem;
  }

  .help-prose :global(th),
  .help-prose :global(td) {
    border: 1px solid hsl(var(--border));
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .help-prose :global(th) {
    background: hsl(var(--secondary));
    font-weight: 600;
  }

  .help-prose :global(blockquote) {
    border-left: 3px solid hsl(var(--border));
    padding-left: 1rem;
  }

  .help-prose :global(blockquote.callout) {
    border: 1px solid hsl(var(--border));
    border-left-width: 4px;
    border-radius: var(--radius);
    background: hsl(var(--card));
    padding: 0.75rem 1rem;
  }

  .help-prose :global(blockquote.callout p:first-child) {
    margin-top: 0;
  }

  .help-prose :global(blockquote[data-callout='note']) {
    border-left-color: hsl(var(--primary));
  }

  .help-prose :global(blockquote[data-callout='tip']) {
    border-left-color: hsl(var(--ring));
  }

  .help-prose :global(blockquote[data-callout='warning']) {
    border-left-color: hsl(var(--destructive));
  }
</style>
