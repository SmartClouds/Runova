---
import AppScreenshot from '../AppScreenshot.astro';

interface Props {
  /** The name in src/assets/screenshots/manifest.json. */
  name: string;
}

// The screenshot component the feature MDX files use, sized for the article column.
---

<AppScreenshot
  name={Astro.props.name}
  sizes="(min-width: 1200px) 800px, (min-width: 768px) 70vw, 100vw"
  class="not-prose my-8"
/>
