---
import { CATEGORIES, SEVERITIES } from '../../lib/news/api';
import { CATEGORY_LABELS, hasFilters, type NewsFilters, SEVERITY_LABELS } from '../../lib/news/page';
import { CATEGORY_ICONS, SEVERITY_ICONS, SEVERITY_TEXT } from './icons';

// The category and severity chips. They are checkboxes in a GET form, so without JavaScript the
// Apply button submits them as the query string. With JavaScript, the script below applies each
// change at once: it loads the filtered page, swaps in its results and pushes the new URL.

interface Props {
  filters: NewsFilters;
}

const { filters } = Astro.props;
const chip =
  'inline-flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition-colors duration-[120ms] hover:border-primary/60 has-checked:border-primary has-checked:bg-primary/10 has-focus-visible:outline-2 has-focus-visible:outline-ring has-focus-visible:outline-offset-2';
const box = 'size-3.5 accent-primary focus-visible:outline-none';
const legend = 'mb-2 font-medium text-sm';
---

<form data-news-filters method="get" action="/news" class="flex flex-col gap-4">
  <fieldset>
    <legend class={legend}>Category</legend>
    <div class="flex flex-wrap gap-2">
      {
        CATEGORIES.map((category) => {
          const Icon = CATEGORY_ICONS[category];
          return (
            <label class={chip}>
              <input
                type="checkbox"
                name="category"
                value={category}
                checked={filters.categories.includes(category)}
                class={box}
              />
              <Icon aria-hidden="true" className="size-3.5 shrink-0 text-muted-foreground" />
              {CATEGORY_LABELS[category]}
            </label>
          );
        })
      }
    </div>
  </fieldset>
  <fieldset>
    <legend class={legend}>Severity</legend>
    <div class="flex flex-wrap gap-2">
      {
        SEVERITIES.map((severity) => {
          const Icon = SEVERITY_ICONS[severity];
          return (
            <label class={chip}>
              <input
                type="checkbox"
                name="severity"
                value={severity}
                checked={filters.severities.includes(severity)}
                class={box}
              />
              <Icon aria-hidden="true" className={`size-3.5 shrink-0 ${SEVERITY_TEXT[severity]}`} />
              {SEVERITY_LABELS[severity]}
            </label>
          );
        })
      }
    </div>
  </fieldset>
  <div class="flex flex-wrap items-center gap-4">
    <button
      type="submit"
      data-news-apply
      class="rounded-md border px-4 py-2 font-medium text-sm transition-colors duration-[120ms] hover:border-primary/60"
    >
      Apply filters
    </button>
    <a
      href="/news"
      data-news-clear
      hidden={!hasFilters(filters)}
      class="text-muted-foreground text-sm underline underline-offset-4 hover:text-foreground"
    >
      Clear filters
    </a>
  </div>
</form>

<script>
  /** The `/news` URL of the form's checked chips, as a GET submit would build it. */
  function urlOf(form: HTMLFormElement): string {
    const query = new URLSearchParams();
    for (const [name, value] of new FormData(form)) query.append(name, String(value));
    const search = query.toString();
    return search ? `/news?${search}` : '/news';
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-news-filters]')) {
    const results = document.querySelector<HTMLElement>('[data-news-results]');
    const count = document.querySelector<HTMLElement>('[data-news-count]');
    const clear = form.querySelector<HTMLAnchorElement>('[data-news-clear]');
    if (!results || !count) continue;
    let pending: AbortController | undefined;

    /** Shows the news at `url` without leaving the page; any failure falls back to loading it. */
    const show = async (url: string, push: boolean) => {
      pending?.abort();
      const controller = new AbortController();
      pending = controller;
      results.setAttribute('aria-busy', 'true');
      try {
        const response = await fetch(url, { signal: controller.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const next = new DOMParser().parseFromString(await response.text(), 'text/html');
        const nextResults = next.querySelector('[data-news-results]');
        const nextCount = next.querySelector('[data-news-count]');
        if (!nextResults || !nextCount) throw new Error('The page has no results');
        results.innerHTML = nextResults.innerHTML;
        count.textContent = nextCount.textContent;
        document.title = next.title;
        if (push) history.pushState(null, '', url);
        // Back and forward show a URL whose chips may differ from the ones on screen.
        const wanted = new URL(url, location.href).searchParams;
        for (const input of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
          input.checked = wanted.getAll(input.name).includes(input.value);
        }
        if (clear) clear.hidden = !wanted.has('category') && !wanted.has('severity');
      } catch (error) {
        if ((error as Error).name !== 'AbortError') location.assign(url);
      } finally {
        if (pending === controller) results.removeAttribute('aria-busy');
      }
    };

    form.dataset.enhanced = '';
    form.addEventListener('change', () => show(urlOf(form), true));
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      show(urlOf(form), true);
    });
    clear?.addEventListener('click', (event) => {
      event.preventDefault();
      show('/news', true);
    });
    window.addEventListener('popstate', () => show(location.pathname + location.search, false));
  }
</script>

<style>
  /* Each change applies at once with scripts on, so the button is only for browsers without them. */
  form[data-enhanced] [data-news-apply] {
    display: none;
  }
</style>
