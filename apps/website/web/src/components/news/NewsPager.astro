---
import { type NewsFilters, newsListPath } from '../../lib/news/page';

interface Props {
  filters: NewsFilters;
  page: number;
  totalPages: number;
}

const { filters, page, totalPages } = Astro.props;
const link =
  'rounded-md border px-4 py-2 font-medium text-sm transition-colors duration-[120ms] hover:border-primary/60';
---

{
  totalPages > 1 && (
    <nav aria-label="Pagination" class="mt-10 flex flex-wrap items-center justify-between gap-4">
      {page > 1 ? (
        <a href={newsListPath(filters, page - 1)} rel="prev" class={link}>
          Newer items
        </a>
      ) : (
        <span />
      )}
      <p class="text-muted-foreground text-sm max-sm:order-first max-sm:w-full max-sm:text-center">
        Page {page} of {totalPages}
      </p>
      {page < totalPages ? (
        <a href={newsListPath(filters, page + 1)} rel="next" class={link}>
          Older items
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
