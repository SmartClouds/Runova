---
interface Props {
  /** Rendered, sanitized HTML: a help article or a blog post body. */
  html: string;
  class?: string;
}

const { html, class: className } = Astro.props;
---

<div class:list={['prose', className]} set:html={html} />

<style>
  .prose {
    line-height: 1.65;
  }

  .prose :global(h2) {
    margin-top: 3rem;
    scroll-margin-top: 5rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .prose :global(h3),
  .prose :global(h4) {
    margin-top: 2rem;
    scroll-margin-top: 5rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table),
  .prose :global(pre),
  .prose :global(blockquote) {
    margin-top: 1rem;
  }

  .prose :global(p),
  .prose :global(li) {
    max-width: 70ch;
    color: hsl(var(--muted-foreground));
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .prose :global(ol) {
    padding-left: 1.5rem;
    list-style: decimal;
  }

  .prose :global(li + li) {
    margin-top: 0.4rem;
  }

  .prose :global(strong) {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .prose :global(code) {
    border-radius: calc(var(--radius) - 4px);
    background: hsl(var(--secondary));
    padding: 0.1rem 0.35rem;
    color: hsl(var(--secondary-foreground));
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: 1rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(a) {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.925rem;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid hsl(var(--border));
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: hsl(var(--secondary));
    font-weight: 600;
  }

  .prose :global(blockquote) {
    border-left: 3px solid hsl(var(--border));
    padding-left: 1rem;
  }

  .prose :global(blockquote.callout) {
    border: 1px solid hsl(var(--border));
    border-left-width: 4px;
    border-radius: var(--radius);
    background: hsl(var(--card));
    padding: 0.75rem 1rem;
  }

  .prose :global(blockquote.callout p:first-child) {
    margin-top: 0;
  }

  .prose :global(blockquote[data-callout='note']) {
    border-left-color: hsl(var(--primary));
  }

  .prose :global(blockquote[data-callout='tip']) {
    border-left-color: hsl(var(--ring));
  }

  .prose :global(blockquote[data-callout='warning']) {
    border-left-color: hsl(var(--destructive));
  }
</style>
