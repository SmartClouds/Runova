---
import Icon from './effects/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const NAV = [
  { href: '/features', label: 'Features' },
  { href: '/help', label: 'Help' },
  { href: '/download', label: 'Download' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/70"
>
  <div class="mx-auto flex h-14 max-w-[1200px] items-center justify-between gap-4 px-4 md:px-6">
    <a href="/" class="flex items-center gap-2 font-display font-semibold text-lg tracking-tight">
      <img src="/favicon-32.png" alt="" width="24" height="24" class="rounded-[6px]" />
      {/* Phones keep the mark alone, or three links and the toggle do not fit in 320px. */}
      <span class="max-sm:sr-only">Runova</span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1">
      {
        NAV.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isCurrent(href) ? 'page' : undefined}
            class="nav-link relative rounded-md px-2 py-2 font-medium text-muted-foreground text-sm transition-colors duration-[120ms] hover:text-foreground aria-[current=page]:text-foreground sm:px-3"
          >
            {label}
          </a>
        ))
      }
      <a
        href="https://github.com/SmartClouds/Runova"
        rel="noopener"
        aria-label="Runova on GitHub"
        title="Runova on GitHub"
        class="nav-link relative hidden size-9 items-center justify-center rounded-md text-muted-foreground transition-colors duration-[120ms] hover:text-foreground sm:inline-flex"
      >
        <Icon name="github" size={18} />
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  /* A pill fades in behind a link on hover (the hover pattern from transitions.dev, Jakub
     Antalik, written from scratch). The current page gets a small primary dot below it. */
  .nav-link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: hsl(var(--secondary));
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 120ms var(--ease-exit),
      transform 120ms var(--ease-exit);
  }

  .nav-link:hover::before {
    opacity: 1;
    transform: none;
    transition-timing-function: var(--ease-enter);
  }

  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -0.3rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 999px;
    background: hsl(var(--primary));
  }

  nav {
    isolation: isolate;
  }
</style>
