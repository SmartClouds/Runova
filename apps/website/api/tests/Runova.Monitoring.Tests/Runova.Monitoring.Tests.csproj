<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Runova.Monitoring.Core\Runova.Monitoring.Core.csproj" />
    <ProjectReference Include="..\..\src\Runova.Monitoring.Gateway\Runova.Monitoring.Gateway.csproj" />
    <ProjectReference Include="..\..\src\Runova.Monitoring.Node\Runova.Monitoring.Node.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixtures @runova/core's Vitest reads too, so the two parsers can not drift apart. -->
    <None Include="..\..\..\..\..\packages\core\src\health\fixtures\*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The compose files, so a test can check no broker or database port is published (E54). -->
    <None Include="..\..\..\compose.yaml;..\..\..\compose.test.yaml;..\..\..\docker-compose.production.yaml;..\..\..\Caddyfile" LinkBase="Compose" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\monitoring-node\compose.yaml" Link="Compose\monitoring-node.compose.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
