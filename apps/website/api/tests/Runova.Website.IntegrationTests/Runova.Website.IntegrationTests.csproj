<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- "api" names its Program apart from the gateway's: .NET 10 makes a web app's Program public. -->
    <ProjectReference Include="..\..\src\Runova.Website.Api\Runova.Website.Api.csproj" Aliases="global,api" />
    <!-- The end-to-end test of online monitoring (E55) runs the real gateway and a real node. -->
    <ProjectReference Include="..\..\src\Runova.Monitoring.Gateway\Runova.Monitoring.Gateway.csproj" />
    <ProjectReference Include="..\..\src\Runova.Monitoring.Node\Runova.Monitoring.Node.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The link tests' certificates, gateway harness and tiny HTTP server, shared rather than copied. -->
    <Compile Include="..\Runova.Monitoring.Tests\Link\TestPki.cs" Link="Monitoring\Link\TestPki.cs" />
    <Compile Include="..\Runova.Monitoring.Tests\Link\GatewayHarness.cs" Link="Monitoring\Link\GatewayHarness.cs" />
    <Compile Include="..\Runova.Monitoring.Tests\Net\TestHttpServer.cs" Link="Monitoring\Link\TestHttpServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The recorded GitHub release that the unit tests classify, served by the fake GitHub. -->
    <None Include="..\Runova.Website.Tests\Releases\Fixtures\**" Link="Fixtures\Releases\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The REST contract that ApiConventionTests holds the OpenAPI document to. -->
    <None Include="..\..\..\..\..\docs\website\api-contract.md" Link="Contract\api-contract.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Where Snapshot finds the committed snapshots. CallerFilePath would not do: CI builds map
       source paths away. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
