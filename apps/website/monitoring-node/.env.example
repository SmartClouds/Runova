# Copy to .env next to compose.yaml. Only the token is needed.

# The one-time token from the node's page on /admin/monitoring-nodes. It works once, within 24 hours.
NODE_ENROLLMENT_TOKEN=

# Where the node enrolls. Leave it for runovahq.com.
RUNOVA_API_URL=https://runovahq.com

# How many checks run at the same time, and what the container may use.
NODE_CONCURRENCY=64
NODE_MEMORY=512m
NODE_CPUS=1.0
