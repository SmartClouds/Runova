<Project>
  <!-- One version per package for the whole solution. Bump here, never in a project file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Data and identity">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <!-- Design-time only (migrations), referenced by the DevHost so it never ships. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Contracts">
    <PackageVersion Include="Tapper.Attributes" Version="1.15.1" />
    <PackageVersion Include="TypedSignalR.Client.TypeScript.Attributes" Version="1.18.0" />
  </ItemGroup>
  <ItemGroup Label="Mapping">
    <!-- A source generator: mappers are plain code at build time, no reflection at run time. -->
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>
  <ItemGroup Label="Docker">
    <!-- The Testcontainers fork of Docker.DotNet (Engine API 29), over the Unix socket. -->
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup Label="Backups">
    <!-- Server backups (E28): Hangfire runs the schedules and uploads, stored in its own SQLite file. -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <!-- RaisedApp's storage (github.com/raisedapp), not the abandoned Hangfire.SQLite. -->
    <PackageVersion Include="Hangfire.Storage.SQLite" Version="0.4.3" />
    <!-- EF Core 11 moved to SQLitePCLRaw 3, while Hangfire.Storage.SQLite still asks for
         sqlite-net-pcl 1.9 and SQLitePCLRaw.bundle_green 2.1.11. Pinned transitively: sqlite-net-pcl
         1.11 is built against SQLitePCLRaw 3, and lib.e_sqlite3 2.1.11 has a known high severity
         vulnerability (GHSA-2m69-gcr7-jv3q covers 2.1.11 and earlier). -->
    <PackageVersion Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <!-- The cron parser Hangfire's own team publishes, for the next runs a plan screen shows. -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- Backup destinations: FTP and FTPS, and SFTP. -->
    <PackageVersion Include="FluentFTP" Version="55.1.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />
    <!-- A Telegram user account over MTProto (Wiz0u, MIT), for backups sent in parts. -->
    <PackageVersion Include="WTelegramClient" Version="4.4.12" />
  </ItemGroup>
  <ItemGroup Label="Error reporting">
    <!-- Error reporting (E29): the core sends its warnings and errors to a Sentry project as OpenTelemetry
         logs over OTLP/HTTP. Sentry takes OTLP directly, so no Sentry SDK is needed. -->
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
  </ItemGroup>
  <ItemGroup Label="Website traffic">
    <!-- Website traffic (E109): DB-IP Lite's country file (an .mmdb) is read with MaxMind's reader
         (Apache 2.0), and visitors are counted by XxHash64 of a salted address and user agent. -->
    <PackageVersion Include="MaxMind.Db" Version="5.3.0" />
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="DevHost">
    <!-- Reads compose files for the DevHost's simulated docker compose. Never in the release. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <!-- Writes the TRX results file dotnet test asks for, at the platform version xunit.v3 brings. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
